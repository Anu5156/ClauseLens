{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": [
        "backend/**",
        "data/**"
      ]
    },
    "backend/main.py": {
      "maxDuration": 60,
      "includeFiles": [
        "data/**"
      ]
    }
  }
}
