{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "backend/main.py": {
      "maxDuration": 60
    },
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
